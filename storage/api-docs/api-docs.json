{
    "openapi": "3.0.0",
    "info": {
        "title": "Asparecargas Endpoints",
        "description": "Here are the endpoints of Asparecargas",
        "version": "1.0"
    },
    "servers": [
        {
            "url": "https://testing.asparecargas.net"
        }
    ],
    "paths": {
        "/api/v1/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Get enabled products",
                "operationId": "52f07b5c504cf5dead737602311e23a8",
                "responses": {
                    "200": {
                        "description": "Get enabled products",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "type": {
                                                        "type": "string",
                                                        "example": "product"
                                                    },
                                                    "attributes": {
                                                        "properties": {
                                                            "id": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "productName": {
                                                                "type": "string",
                                                                "example": "BANCOLOMBIA"
                                                            },
                                                            "productDescription": {
                                                                "type": "string",
                                                                "example": "<p>DEPOSITO BANCOLOMBIA</p>"
                                                            },
                                                            "productLogo": {
                                                                "type": "string",
                                                                "example": "https://example.com/storage/products/1.png"
                                                            },
                                                            "productCommission": {
                                                                "type": "integer",
                                                                "example": 800
                                                            },
                                                            "producType": {
                                                                "type": "string",
                                                                "example": "Deposit"
                                                            },
                                                            "clientName": {
                                                                "type": "integer",
                                                                "example": 0
                                                            },
                                                            "clientDocument": {
                                                                "type": "integer",
                                                                "example": 0
                                                            },
                                                            "phoneNumber": {
                                                                "type": "integer",
                                                                "example": 0
                                                            },
                                                            "email": {
                                                                "type": "integer",
                                                                "example": 0
                                                            },
                                                            "accountType": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "accountNumber": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "code": {
                                                                "type": "integer",
                                                                "example": 0
                                                            },
                                                            "extra": {
                                                                "type": "integer",
                                                                "example": 0
                                                            },
                                                            "areDefaultFields": {
                                                                "type": "integer",
                                                                "example": 1
                                                            },
                                                            "fieldNames": {
                                                                "type": "string",
                                                                "example": "Número de seguro,Número de NIT,Número de registro civil"
                                                            },
                                                            "minAmount": {
                                                                "type": "integer",
                                                                "example": 5000
                                                            },
                                                            "maxAmount": {
                                                                "type": "integer",
                                                                "example": 300000
                                                            },
                                                            "category": {
                                                                "type": "string",
                                                                "example": "bancos"
                                                            }
                                                        },
                                                        "type": "object"
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "passport": []
                    }
                ]
            }
        },
        "/api/v1/transaction/create": {
            "post": {
                "tags": [
                    "Transaction"
                ],
                "summary": "Create Transaction",
                "operationId": "1638ec919252ee286da613c58cdc91b6",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "productID": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "accountNumber": {
                                        "type": "string",
                                        "example": "1234567890"
                                    },
                                    "amount": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 20000.5
                                    },
                                    "type": {
                                        "type": "string",
                                        "example": "Deposit"
                                    },
                                    "detail": {
                                        "type": "string",
                                        "example": "Tipo de cuenta: Ahorros,Nit: 332435,"
                                    },
                                    "date": {
                                        "type": "string",
                                        "example": "2024-09-10"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success Transaction Creation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "transactionID": {
                                            "type": "integer",
                                            "example": "3111"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Transacción asignada a proveedor"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "There are no suppliers",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "transactionID": {
                                            "type": "integer",
                                            "example": "3111"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "No hay proveedores disponibles"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Transaction limit per period exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "transactionID": {
                                            "type": "integer",
                                            "example": "3111"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Esta cuenta superó el límite de transacciones por periodo, podrá realizar transacciones con la misma a partir de las 11:06 PM"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/user/login": {
            "post": {
                "tags": [
                    "Login"
                ],
                "summary": "User Login",
                "operationId": "f8cb634ff438083cd231d25a056e3497",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success Login",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Success Login"
                                        },
                                        "access_token": {
                                            "type": "string",
                                            "example": "***REMOVED***"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Invalid Credentials"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden Access",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Forbidden Access"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Products",
            "description": "Products"
        },
        {
            "name": "Transaction",
            "description": "Transaction"
        },
        {
            "name": "Login",
            "description": "Login"
        }
    ],
    "components": {
        "securitySchemes": {
            "passport": {
                "type": "apiKey",
                "description": "Ingrese el token en el formato (Bearer <token>)",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "security": [
        {
            "passport": []
        }
    ]
}