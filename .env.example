APP_NAME="Fintech Correspondent Banking Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
PROJECT_ENVIRONMENT=local

# Country deployment (one instance per country)
COUNTRY_NAME=COLOMBIA
COUNTRY_CODE=57
RUT_NAME=RUT
LOAD_BACKGROUND=/assets/img/load-colombia.jpeg

# Public server that stores uploaded images (receives POST /upload.php)
URL_SERVER=
URL_UPLOADER=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fintech_correspondents
DB_USERNAME=fintech_user
DB_PASSWORD=fintech_secret

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="notifications@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Receives the output of the scheduled commands
MAIL_REPORTS_TO=ops@example.com

# WebSockets Server (beyondcode/laravel-websockets)
LARAVEL_WEBSOCKETS_HOST=0.0.0.0
LARAVEL_WEBSOCKETS_PORT=6001

# Pusher / WebSockets Credentials
PUSHER_APP_ID=fintech_app_id
PUSHER_APP_KEY=fintech_app_key
PUSHER_APP_SECRET=fintech_app_secret
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# L5 Swagger API Documentation
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_CONST_HOST=http://localhost:8000
